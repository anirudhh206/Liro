# ADR-9: every third-party key is runtime config. Copy this file to .env and
# fill in real values. .env is git-ignored from commit one. No exceptions.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (ADR-7) ---
# Symmetric secret used to sign/verify session tokens issued at onboarding.
SESSION_JWT_SECRET=

# --- Postgres (Supabase) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Solana / Pyth / Jupiter / Kamino ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PYTH_HERMES_URL=https://hermes.pyth.network
JUPITER_SWAP_API_URL=https://lite-api.jup.ag/swap/v1

# --- Turnkey (ADR-1: policy-scoped session signers) ---
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# --- Lightspark Grid (ADR-3: real payout sandbox, KYB-gated) ---
GRID_CLIENT_ID=
GRID_CLIENT_SECRET=
GRID_ENVIRONMENT=sandbox

# --- IP geolocation (ADR-5 cross-check) ---
IP_GEOLOCATION_API_URL=
IP_GEOLOCATION_API_KEY=
